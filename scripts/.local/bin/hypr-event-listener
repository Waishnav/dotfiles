#!/bin/bash
# Reconcile the external monitor without treating idle/wake link training as a
# real unplug. Window migration only follows a stable, awake disconnect.

set -o pipefail

EXTERNAL_MONITOR="${EXTERNAL_MONITOR:-HDMI-A-1}"
LAPTOP_MONITOR="${LAPTOP_MONITOR:-eDP-1}"
LOG_FILE="${LOG_FILE:-/tmp/hypr-event-listener.log}"
LAYOUT_FILE="${HYPR_EXTERNAL_LAYOUT_FILE:-/tmp/hypr-external-layout.json}"

# An awake unplug should collapse onto the laptop almost immediately. DPMS-off
# removals use the dormant/wake-grace path below and retain their longer safety
# window, so this short debounce does not reintroduce AFK wake reshuffling.
REMOVE_DEBOUNCE="${REMOVE_DEBOUNCE:-1}"
ADD_DEBOUNCE="${ADD_DEBOUNCE:-3}"
PROBE_INTERVAL="${PROBE_INTERVAL:-5}"
WAKE_GRACE="${WAKE_GRACE:-15}"
CONNECTED_WAKE_GRACE="${CONNECTED_WAKE_GRACE:-30}"
RECOVERY_COOLDOWN="${RECOVERY_COOLDOWN:-20}"

LAPTOP_WORKSPACES=(1 2 3 4 5 6)
EXTERNAL_WORKSPACES=(11 12 13 14 15 16)

# present: HDMI is active
# dormant: HDMI disappeared while every known output was DPMS-off
# wake-grace: the laptop woke and HDMI is allowed time to train
# absent: HDMI is genuinely unavailable while awake
STATE="${STATE:-unknown}"
WAKE_GRACE_STARTED_AT=0
LAST_RECOVERY=0
LAYOUT_READY=0
MONITORS_JSON=""

log() {
    printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$1" >> "$LOG_FILE"
}

now_seconds() {
    date +%s
}

read_monitor_snapshot() {
    local snapshot
    if ! snapshot=$(hyprctl monitors -j 2>/dev/null); then
        return 1
    fi
    if ! jq -e 'type == "array"' <<< "$snapshot" >/dev/null 2>&1; then
        return 1
    fi
    MONITORS_JSON="$snapshot"
}

external_state_from_snapshot() {
    if jq -e --arg monitor "$EXTERNAL_MONITOR" \
        'any(.[]; .name == $monitor)' <<< "$MONITORS_JSON" >/dev/null 2>&1; then
        printf 'present\n'
    else
        printf 'absent\n'
    fi
}

power_state_from_snapshot() {
    if jq -e 'length > 0 and all(.[]; .dpmsStatus == false)' \
        <<< "$MONITORS_JSON" >/dev/null 2>&1; then
        printf 'dormant\n'
    elif jq -e 'length > 0 and any(.[]; .dpmsStatus == true)' \
        <<< "$MONITORS_JSON" >/dev/null 2>&1; then
        printf 'awake\n'
    else
        printf 'unknown\n'
    fi
}

external_monitor_state() {
    if ! read_monitor_snapshot; then
        printf 'unknown\n'
        return
    fi
    external_state_from_snapshot
}

connector_connected() {
    local status_file
    for status_file in /sys/class/drm/card*-"$EXTERNAL_MONITOR"/status; do
        if [[ -r "$status_file" ]] && [[ "$(<"$status_file")" == "connected" ]]; then
            return 0
        fi
    done
    return 1
}

# Return 0 when the requested state remains stable, 1 when it changes, and 2
# when Hyprland cannot provide a trustworthy reading.
wait_for_external_state() {
    local expected="$1"
    local duration="$2"
    local current
    local second

    for ((second = 0; second < duration; second++)); do
        current=$(external_monitor_state)
        [[ "$current" == "unknown" ]] && return 2
        [[ "$current" == "$expected" ]] || return 1
        sleep 1
    done

    current=$(external_monitor_state)
    [[ "$current" == "unknown" ]] && return 2
    [[ "$current" == "$expected" ]]
}

save_external_layout() {
    HYPR_EXTERNAL_LAYOUT_FILE="$LAYOUT_FILE" \
        ~/.local/bin/hypr-save-layout >> "$LOG_FILE" 2>&1
}

migrate_windows_to_laptop() {
    local clients
    local failed=0
    local laptop_ws
    local windows
    local address
    local ws

    if ! clients=$(hyprctl clients -j 2>/dev/null) ||
        ! jq -e 'type == "array"' <<< "$clients" >/dev/null 2>&1; then
        log "Cannot read Hyprland clients; postponing window migration"
        return 1
    fi

    log "Migrating windows from external workspaces..."
    for ws in "${EXTERNAL_WORKSPACES[@]}"; do
        laptop_ws=$((ws - 10))
        windows=$(jq -r --argjson workspace "$ws" \
            '.[] | select(.workspace.id == $workspace) | .address' <<< "$clients")
        for address in $windows; do
            if ! hyprctl dispatch movetoworkspacesilent \
                "$laptop_ws,address:$address" >/dev/null 2>&1; then
                log "Failed to move window $address from WS $ws"
                failed=1
            fi
        done
    done

    for ws in "${EXTERNAL_WORKSPACES[@]}"; do
        if ! hyprctl keyword workspace "$ws,persistent:false" >/dev/null 2>&1; then
            log "Failed to disable persistence for WS $ws"
            failed=1
        fi
    done

    ((failed == 0))
}

enable_external_workspaces() {
    local failed=0
    local ws

    for ws in "${EXTERNAL_WORKSPACES[@]}"; do
        if ! hyprctl keyword workspace \
            "$ws,monitor:$EXTERNAL_MONITOR,persistent:true" >/dev/null 2>&1; then
            log "Failed to restore persistence for WS $ws"
            failed=1
        fi
    done

    ((failed == 0))
}

sync_external_to_laptop_workspace() {
    local laptop_ws
    local external_ws

    if ! laptop_ws=$(hyprctl monitors -j 2>/dev/null |
        jq -er --arg monitor "$LAPTOP_MONITOR" \
            '.[] | select(.name == $monitor) | .activeWorkspace.id'); then
        log "Cannot determine the laptop workspace"
        return 1
    fi

    if ! [[ "$laptop_ws" =~ ^[0-9]+$ ]] ||
        ((laptop_ws < 1 || laptop_ws > ${#LAPTOP_WORKSPACES[@]})); then
        log "Laptop workspace $laptop_ws is outside the synchronized range"
        return 1
    fi

    external_ws=$((laptop_ws + 10))
    if ! hyprctl dispatch focusmonitor "$EXTERNAL_MONITOR" >/dev/null 2>&1; then
        return 1
    fi
    if ! hyprctl dispatch workspace "$external_ws" >/dev/null 2>&1; then
        hyprctl dispatch focusmonitor "$LAPTOP_MONITOR" >/dev/null 2>&1 || true
        return 1
    fi
    hyprctl dispatch focusmonitor "$LAPTOP_MONITOR" >/dev/null 2>&1
}

restore_external_layout() {
    ((LAYOUT_READY == 1)) || return 0
    [[ -s "$LAYOUT_FILE" ]] || return 0
    HYPR_EXTERNAL_LAYOUT_FILE="$LAYOUT_FILE" \
        ~/.local/bin/hypr-restore-layout >> "$LOG_FILE" 2>&1
}

restore_external_configuration() {
    local failed=0

    enable_external_workspaces || failed=1
    sync_external_to_laptop_workspace || failed=1
    restore_external_layout || failed=1

    # A snapshot belongs to one genuine disconnect/reconnect cycle. Never
    # replay it on a later DPMS wake, even when one best-effort operation failed.
    LAYOUT_READY=0
    rm -f -- "$LAYOUT_FILE"

    ((failed == 0))
}

transition_to_dormant() {
    [[ "$STATE" == "absent" || "$STATE" == "dormant" ]] && return 0
    STATE="dormant"
    WAKE_GRACE_STARTED_AT=0
    log "HDMI disappeared while DPMS was off; holding external workspaces"
}

begin_wake_grace() {
    [[ "$STATE" == "wake-grace" ]] && return 0
    STATE="wake-grace"
    WAKE_GRACE_STARTED_AT=$(now_seconds)
    log "Laptop woke before HDMI; waiting for link training"
}

transition_to_absent() {
    [[ "$STATE" == "absent" ]] && return 0

    # Keep a successful snapshot across migration retries. Re-saving after a
    # partial migration would lose the windows that already moved.
    if ((LAYOUT_READY == 0)); then
        if save_external_layout; then
            LAYOUT_READY=1
            log "External layout saved"
        else
            log "Layout save failed; migration will continue without automatic restoration"
        fi
    fi

    if ! migrate_windows_to_laptop; then
        log "Window migration failed; keeping state for retry"
        return 1
    fi

    STATE="absent"
    WAKE_GRACE_STARTED_AT=0
    log "External monitor confirmed absent"
}

transition_to_present() {
    case "$STATE" in
        absent)
            log "External monitor stable; restoring workspace layout"
            # Physical monitor truth does not depend on whether every saved
            # application survived or accepted its workspace move.
            STATE="present"
            WAKE_GRACE_STARTED_AT=0
            if ! restore_external_configuration; then
                log "Workspace restoration completed with errors"
            fi
            log "External monitor restored"
            ;;
        dormant | wake-grace)
            STATE="present"
            WAKE_GRACE_STARTED_AT=0
            log "HDMI returned during wake; no window migration was needed"
            ;;
        unknown)
            STATE="present"
            log "External monitor present at initialization"
            ;;
        present) ;;
    esac
}

request_monitor_reload() {
    local now
    now=$(now_seconds)

    ((now - LAST_RECOVERY >= RECOVERY_COOLDOWN)) || return 0
    log "DRM reports HDMI connected but inactive; reloading monitor configuration"
    if hyprctl reload >> "$LOG_FILE" 2>&1; then
        LAST_RECOVERY=$now
    else
        log "Hyprland monitor reload failed"
        return 1
    fi
}

handle_confirmed_absence() {
    local power_state

    if ! read_monitor_snapshot; then
        log "Monitor query failed after debounce; preserving state=$STATE"
        return 1
    fi
    if [[ "$(external_state_from_snapshot)" == "present" ]]; then
        transition_to_present
        return
    fi

    power_state=$(power_state_from_snapshot)
    case "$power_state" in
        dormant)
            transition_to_dormant
            ;;
        awake)
            case "$STATE" in
                dormant)
                    begin_wake_grace
                    ;;
                wake-grace)
                    handle_wake_grace
                    ;;
                present | unknown)
                    transition_to_absent
                    ;;
                absent) ;;
            esac
            ;;
        unknown)
            log "DPMS state is unknown; preserving state=$STATE"
            ;;
    esac
}

handle_wake_grace() {
    local elapsed
    local grace_limit="$WAKE_GRACE"

    ((WAKE_GRACE_STARTED_AT > 0)) || WAKE_GRACE_STARTED_AT=$(now_seconds)
    elapsed=$(($(now_seconds) - WAKE_GRACE_STARTED_AT))

    if connector_connected; then
        grace_limit="$CONNECTED_WAKE_GRACE"
        request_monitor_reload || true
    fi

    if ((elapsed < grace_limit)); then
        return 0
    fi

    log "HDMI remained absent for ${elapsed}s after wake"
    transition_to_absent
}

reconcile_present_monitor() {
    case "$STATE" in
        absent)
            local wait_result
            wait_for_external_state present "$ADD_DEBOUNCE"
            wait_result=$?
            case "$wait_result" in
                0) transition_to_present ;;
                1) log "HDMI presence was transient; retaining absent state" ;;
                2) log "Monitor query failed during add debounce; retaining absent state" ;;
            esac
            ;;
        dormant | wake-grace | unknown)
            transition_to_present
            ;;
        present) ;;
    esac
}

reconcile_state() {
    local external_state
    local power_state
    local wait_result

    if ! read_monitor_snapshot; then
        log "Monitor query failed; preserving state=$STATE"
        return 1
    fi

    external_state=$(external_state_from_snapshot)
    if [[ "$external_state" == "present" ]]; then
        reconcile_present_monitor
        return
    fi

    power_state=$(power_state_from_snapshot)
    if [[ "$power_state" == "dormant" ]]; then
        transition_to_dormant
        return
    fi
    if [[ "$power_state" == "unknown" ]]; then
        log "DPMS state is unknown; preserving state=$STATE"
        return 1
    fi

    case "$STATE" in
        dormant)
            begin_wake_grace
            ;;
        wake-grace)
            handle_wake_grace
            ;;
        absent)
            connector_connected && request_monitor_reload
            ;;
        present | unknown)
            wait_for_external_state absent "$REMOVE_DEBOUNCE"
            wait_result=$?
            case "$wait_result" in
                0) handle_confirmed_absence ;;
                1) log "HDMI recovered during remove debounce; ignoring flap" ;;
                2) log "Monitor query failed during remove debounce; preserving state=$STATE" ;;
            esac
            ;;
    esac
}

handle_event() {
    local wait_result

    case "$1" in
        "monitorremoved>>$EXTERNAL_MONITOR")
            [[ "$STATE" == "absent" ]] && return 0
            log "Monitor removed: $EXTERNAL_MONITOR"
            wait_for_external_state absent "$REMOVE_DEBOUNCE"
            wait_result=$?
            case "$wait_result" in
                0) handle_confirmed_absence ;;
                1) log "HDMI recovered during remove debounce; ignoring flap" ;;
                2) log "Monitor query failed during remove debounce; preserving state=$STATE" ;;
            esac
            ;;
        "monitoradded>>$EXTERNAL_MONITOR")
            log "Monitor added: $EXTERNAL_MONITOR"
            wait_for_external_state present "$ADD_DEBOUNCE"
            wait_result=$?
            case "$wait_result" in
                0) transition_to_present ;;
                1) log "HDMI add was transient; ignoring" ;;
                2) log "Monitor query failed during add debounce; preserving state=$STATE" ;;
            esac
            ;;
    esac
}

cleanup() {
    trap - EXIT INT TERM
    [[ -n "${SOCKET_PID:-}" ]] && kill "$SOCKET_PID" 2>/dev/null || true
    [[ -n "${SOCKET_PID:-}" ]] && wait "$SOCKET_PID" 2>/dev/null || true
}

resolve_socket() {
    local signature="${HYPRLAND_INSTANCE_SIGNATURE:-}"

    if [[ -z "$signature" ]]; then
        signature=$(find "$RUNTIME_DIR/hypr" -mindepth 1 -maxdepth 1 -type d \
            -printf '%f\n' 2>/dev/null | head -1)
    fi
    [[ -n "$signature" ]] || return 1
    SOCKET="$RUNTIME_DIR/hypr/$signature/.socket2.sock"
}

event_loop() {
    local event_fd
    local line
    local read_result

    while true; do
        # A coprocess owns the socket for the whole session. The previous
        # process-substitution FD was repeatedly closed after ordinary events,
        # producing Broken pipe churn and starving periodic reconciliation.
        coproc HYPR_EVENTS {
            exec socat -U - UNIX-CONNECT:"$SOCKET" 2>> "$LOG_FILE"
        }
        SOCKET_PID=$HYPR_EVENTS_PID
        event_fd=${HYPR_EVENTS[0]}

        while true; do
            if IFS= read -r -t "$PROBE_INTERVAL" -u "$event_fd" line; then
                [[ -n "$line" ]] && handle_event "$line"
                continue
            else
                # Capture read's status inside the else branch. The status of
                # an `if` with no executed branch is 0, which previously made
                # every timeout look like EOF and closed the live socket.
                read_result=$?
                if ((read_result > 128)); then
                    reconcile_state || true
                    continue
                fi
            fi
            break
        done

        exec {event_fd}<&-
        wait "$SOCKET_PID" 2>/dev/null || true
        SOCKET_PID=""
        unset HYPR_EVENTS HYPR_EVENTS_PID
        sleep 1
    done
}

main() {
    RUNTIME_DIR="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
    LOCK_FILE="$RUNTIME_DIR/hypr-event-listener.lock"
    resolve_socket || {
        printf 'Cannot locate the Hyprland event socket\n' >&2
        return 1
    }

    exec 9> "$LOCK_FILE"
    flock -n 9 || return 0

    echo "=== hypr-event-listener started $(date) ===" > "$LOG_FILE"
    log "Listening for monitor events..."

    trap cleanup EXIT
    trap 'exit 0' INT TERM

    reconcile_state || true
    event_loop
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
