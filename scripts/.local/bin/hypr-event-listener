#!/bin/bash
# Reconcile the external monitor without treating a transient HDMI flap as a
# real unplug. Windows move only after a stable, awake disconnect.

set -o pipefail

EXTERNAL_MONITOR="HDMI-A-1"
LAPTOP_MONITOR="eDP-1"
LOG_FILE="/tmp/hypr-event-listener.log"

REMOVE_DEBOUNCE=6
ADD_DEBOUNCE=3
PROBE_INTERVAL=5
RECOVERY_COOLDOWN=20

RUNTIME_DIR="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
FIFO="$RUNTIME_DIR/hypr-event-listener.fifo"
LOCK_FILE="$RUNTIME_DIR/hypr-event-listener.lock"

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    SOCKET="$RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
else
    SOCKET="$RUNTIME_DIR/hypr/$(find "$RUNTIME_DIR/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | head -1)/.socket2.sock"
fi

# present: monitor is available; dormant: monitor disappeared while all
# outputs were DPMS-off; absent: monitor is genuinely unavailable while awake.
STATE="unknown"
LAST_RECOVERY=0

log() {
    printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$1" >> "$LOG_FILE"
}

external_present() {
    hyprctl monitors -j 2>/dev/null |
        jq -e --arg monitor "$EXTERNAL_MONITOR" 'any(.[]; .name == $monitor)' >/dev/null 2>&1
}

connector_connected() {
    local status_file
    for status_file in /sys/class/drm/card*-"$EXTERNAL_MONITOR"/status; do
        if [[ -r "$status_file" ]] && [[ "$(<"$status_file")" == "connected" ]]; then
            return 0
        fi
    done
    return 1
}

system_dormant() {
    # Hyprland reports dpmsStatus as a boolean for each currently-known output.
    hyprctl monitors -j 2>/dev/null |
        jq -e 'length > 0 and all(.[]; .dpmsStatus == false)' >/dev/null 2>&1
}

monitor_present_stably() {
    local i
    for ((i = 1; i <= ADD_DEBOUNCE; i++)); do
        external_present || return 1
        sleep 1
    done
    return 0
}

monitor_absent_stably() {
    local i
    for ((i = 1; i <= REMOVE_DEBOUNCE; i++)); do
        external_present && return 1
        sleep 1
    done
    ! external_present
}

migrate_windows_to_laptop() {
    log "Migrating windows from external to laptop..."
    for ws in 11 12 13 14 15 16; do
        local laptop_ws=$((ws - 10))
        local windows
        windows=$(hyprctl clients -j 2>/dev/null | jq -r ".[] | select(.workspace.id == $ws) | .address")
        for address in $windows; do
            if [[ -n "$address" ]]; then
                log "  Moving window $address from WS $ws to WS $laptop_ws"
                hyprctl dispatch movetoworkspacesilent "$laptop_ws,address:$address" >/dev/null 2>&1 ||
                    log "  Failed to move window $address"
            fi
        done
    done

    # Real unplug only: allow Hyprland to remove unused external workspaces.
    for ws in 11 12 13 14 15 16; do
        hyprctl keyword workspace "$ws,persistent:false" >/dev/null 2>&1 ||
            log "  Failed to disable persistence for WS $ws"
    done
    log "Migration complete"
}

sync_to_current_workspace() {
    local current_ws external_ws

    for ws in 11 12 13 14 15 16; do
        hyprctl keyword workspace "$ws,monitor:$EXTERNAL_MONITOR,persistent:true" >/dev/null 2>&1 ||
            log "  Failed to restore persistence for WS $ws"
    done

    current_ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id')
    if [[ "$current_ws" =~ ^[0-9]+$ ]] && ((current_ws >= 1 && current_ws <= 6)); then
        external_ws=$((current_ws + 10))
        hyprctl dispatch focusmonitor "$EXTERNAL_MONITOR" >/dev/null 2>&1 || return 1
        hyprctl dispatch workspace "$external_ws" >/dev/null 2>&1 || return 1
        hyprctl dispatch focusmonitor "$LAPTOP_MONITOR" >/dev/null 2>&1 || return 1
    fi
}

restore_external_layout() {
    if [[ -s /tmp/hypr-external-layout.json ]]; then
        ~/.local/bin/hypr-restore-layout >> "$LOG_FILE" 2>&1 ||
            log "Window layout restoration reported an error"
    fi
}

transition_to_dormant() {
    [[ "$STATE" == "absent" || "$STATE" == "dormant" ]] && return 0
    STATE="dormant"
    log "HDMI disappeared while DPMS was off; holding external workspaces"
}

transition_to_absent() {
    [[ "$STATE" == "absent" ]] && return 0

    STATE="absent"
    log "External monitor absent while awake; saving and migrating layout"
    if ~/.local/bin/hypr-save-layout >> "$LOG_FILE" 2>&1; then
        log "Layout saved"
    else
        log "Layout save failed; continuing with window migration"
    fi
    migrate_windows_to_laptop
}

transition_to_present() {
    case "$STATE" in
        absent)
            log "External monitor stable; restoring workspace layout"
            if ! sync_to_current_workspace; then
                log "Workspace restoration failed; will retry on the next probe"
                return 1
            fi
            restore_external_layout
            STATE="present"
            log "External monitor restored without Waybar reload"
            ;;
        dormant)
            STATE="present"
            log "External monitor returned from dormant state; no window migration to undo"
            ;;
        unknown)
            STATE="present"
            log "External monitor present at initialization"
            ;;
        present)
            ;;
    esac
}

reconcile_state() {
    if external_present; then
        if [[ "$STATE" == "absent" ]] && monitor_present_stably; then
            transition_to_present
        elif [[ "$STATE" == "dormant" ]]; then
            transition_to_present
        elif [[ "$STATE" == "unknown" ]]; then
            transition_to_present
        fi
        return 0
    fi

    if system_dormant; then
        transition_to_dormant
        return 0
    fi

    # This is the important dormant -> absent transition: the user woke the
    # laptop, but the external monitor never came back.
    if [[ "$STATE" == "dormant" ]]; then
        transition_to_absent
        return 0
    fi

    if [[ "$STATE" == "unknown" || "$STATE" == "present" ]] && monitor_absent_stably; then
        if system_dormant; then
            transition_to_dormant
        else
            transition_to_absent
        fi
    fi
}

probe_connector() {
    local now
    now=$(date +%s)

    # DRM can know that a physical connector is connected before Hyprland has
    # recreated its monitor object. Reload the normal monitor configuration;
    # output create is for virtual outputs and cannot fix this case.
    if ! external_present && connector_connected && ((now - LAST_RECOVERY >= RECOVERY_COOLDOWN)); then
        log "DRM reports HDMI connected but Hyprland has no HDMI output; requesting config reload"
        if hyprctl reload >> "$LOG_FILE" 2>&1; then
            LAST_RECOVERY=$now
        else
            log "Hyprland config reload failed"
        fi
    fi

    reconcile_state
}

handle_event() {
    case "$1" in
        "monitorremoved>>$EXTERNAL_MONITOR")
            log "Monitor removed: $EXTERNAL_MONITOR (waiting for stable state)"
            if monitor_absent_stably; then
                reconcile_state
            else
                log "HDMI flap recovered within ${REMOVE_DEBOUNCE}s; ignoring"
            fi
            ;;
        "monitoradded>>$EXTERNAL_MONITOR")
            log "Monitor added: $EXTERNAL_MONITOR (waiting for stable state)"
            if monitor_present_stably; then
                transition_to_present
            else
                log "HDMI add was transient; ignoring"
            fi
            ;;
    esac
}

cleanup() {
    kill "$SOCKET_LOOP_PID" "$PROBE_PID" 2>/dev/null || true
    rm -f "$FIFO"
}

# Do not allow a second listener to delete the first listener's FIFO.
exec 9> "$LOCK_FILE"
if ! flock -n 9; then
    exit 0
fi

echo "=== hypr-event-listener started $(date) ===" > "$LOG_FILE"
log "Listening for monitor events..."

rm -f "$FIFO"
if ! mkfifo "$FIFO"; then
    log "FATAL: cannot create event FIFO $FIFO"
    exit 1
fi

# Keep reconnecting if the Hyprland socket disappears. The FIFO preserves a
# single serialized stream for socket events and probe ticks.
(
    while true; do
        socat -U - UNIX-CONNECT:"$SOCKET" 2>> "$LOG_FILE" || true
        sleep 1
    done
) > "$FIFO" &
SOCKET_LOOP_PID=$!

(
    while true; do
        sleep "$PROBE_INTERVAL"
        printf '__PROBE__\n' > "$FIFO"
    done
) &
PROBE_PID=$!

trap cleanup EXIT INT TERM

exec 3< "$FIFO"

# Reconcile the state in case the listener started after a monitor event.
if external_present; then
    STATE="present"
elif system_dormant; then
    STATE="dormant"
    log "Starting dormant with HDMI absent; holding external workspaces"
else
    reconcile_state
fi

while IFS= read -r line <&3; do
    [[ -n "$line" ]] || continue
    if [[ "$line" == "__PROBE__" ]]; then
        probe_connector
    else
        handle_event "$line"
    fi
done
