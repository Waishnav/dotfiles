#!/bin/bash
# Listen to Hyprland events and handle monitor changes
# Syncs workspaces when external monitor is connected/disconnected
#
# Behavior:
# - Short HDMI flaps (link retraining, monitor power-cycling during idle/wake)
#   are debounced and ignored, so no window migration happens on wake.
# - If the external monitor disappears while the system is dormant (dpms off),
#   windows are NOT migrated. Workspaces stay persistent and simply wait for
#   the monitor to come back, so wake-up is a visual no-op.
# - If it disappears while the system is awake, windows are migrated to the
#   laptop workspaces (real unplug / power cut while in use).
# - A periodic probe re-enumerates the connector when DRM reports "connected"
#   but Hyprland lost the monitor (e.g. power restored after a cut), using
#   `hyprctl output create`.

EXTERNAL_MONITOR="HDMI-A-1"
LAPTOP_MONITOR="eDP-1"
LOG_FILE="/tmp/hypr-event-listener.log"
REMOVE_DEBOUNCE=6      # seconds before a removal is accepted as real
ADD_DEBOUNCE=3         # seconds the monitor must stay present before acting
PROBE_INTERVAL=20      # seconds between connector re-enumeration checks
FIFO="$XDG_RUNTIME_DIR/hypr-event-listener.fifo"
SOCKET="$XDG_RUNTIME_DIR/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-$(ls "$XDG_RUNTIME_DIR"/hypr 2>/dev/null | head -1)}/.socket2.sock"

STATE="present"        # present | dormant | absent

log() {
    echo "[$(date '+%H:%M:%S')] $1" >> "$LOG_FILE"
}

external_present() {
    hyprctl monitors -j | jq -e --arg m "$EXTERNAL_MONITOR" '.[] | select(.name == $m)' >/dev/null 2>&1
}

connector_connected() {
    for f in /sys/class/drm/card*-"$EXTERNAL_MONITOR"/status; do
        [[ -r "$f" ]] && [[ "$(cat "$f")" == "connected" ]] && return 0
    done
    return 1
}

# All remaining monitors are dpms off -> idle/lock/suspend, user is away
system_dormant() {
    hyprctl monitors -j | jq -e '[.[].dpmsStatus] | length > 0 and (all(.; . == false))' >/dev/null 2>&1
}

# Migrate all windows from external workspaces (11-16) to laptop workspaces (1-6)
migrate_windows_to_laptop() {
    log "Migrating windows from external to laptop..."
    for ws in 11 12 13 14 15 16; do
        laptop_ws=$((ws - 10))
        windows=$(hyprctl clients -j | jq -r ".[] | select(.workspace.id == $ws) | .address")
        for addr in $windows; do
            if [[ -n "$addr" ]]; then
                log "  Moving window $addr from WS $ws to WS $laptop_ws"
                hyprctl dispatch movetoworkspacesilent "$laptop_ws,address:$addr"
            fi
        done
    done
    log "Migration complete"

    # Remove persistent flag from external workspaces so Hyprland auto-removes them
    log "Removing external workspaces persistence..."
    for ws in 11 12 13 14 15 16; do
        hyprctl keyword workspace "$ws,persistent:false" 2>/dev/null
    done
    log "External workspaces marked non-persistent"
}

# When external monitor connects (real removal earlier), restore workspaces and sync
sync_to_current_workspace() {
    log "External monitor connected, restoring workspaces..."

    # Restore persistent workspaces on external monitor
    for ws in 11 12 13 14 15 16; do
        hyprctl keyword workspace "$ws,monitor:$EXTERNAL_MONITOR,persistent:true" 2>/dev/null
    done
    log "  Restored persistent workspaces 11-16"

    # Get current laptop workspace and sync external to paired workspace
    current_ws=$(hyprctl activeworkspace -j | jq -r '.id')
    if [[ "$current_ws" -ge 1 && "$current_ws" -le 6 ]]; then
        external_ws=$((current_ws + 10))
        log "  Switching external to WS $external_ws (paired with laptop WS $current_ws)"
        hyprctl dispatch focusmonitor "$EXTERNAL_MONITOR"
        hyprctl dispatch workspace "$external_ws"
        hyprctl dispatch focusmonitor "$LAPTOP_MONITOR"
    fi
    log "Sync complete"
}

update_waybar() {
    log "Updating waybar config..."
    ~/.local/bin/hypr-update-waybar
    log "Waybar updated"
}

handle_removed() {
    [[ "$1" == "$EXTERNAL_MONITOR" ]] || return 0

    case "$STATE" in
        dormant|absent)
            log "Ignoring remove event (state=$STATE)"
            return 0
            ;;
    esac

    log "Monitor removed: $1 (suspected)"

    # Debounce: if the monitor is back within REMOVE_DEBOUNCE seconds,
    # this was a flap (link retraining / power cycling) - do nothing.
    for ((i = 1; i <= REMOVE_DEBOUNCE; i++)); do
        sleep 1
        if external_present; then
            log "Flap: monitor back after ${i}s, ignoring"
            return 0
        fi
    done

    # Removal confirmed. If the system is dormant (dpms off, user away),
    # hold the workspaces - windows wait invisibly for the monitor to return.
    if system_dormant; then
        STATE="dormant"
        log "Removal during dormant state - holding external workspaces (no migration)"
        return 0
    fi

    STATE="absent"
    log "Removal confirmed (system awake) - migrating windows"
    ~/.local/bin/hypr-save-layout >/dev/null 2>&1
    log "Layout saved"
    migrate_windows_to_laptop
    update_waybar
}

handle_added() {
    [[ "$1" == "$EXTERNAL_MONITOR" ]] || return 0

    # Debounce: the monitor must stay present for ADD_DEBOUNCE seconds
    # (wake-up link training often flaps add/remove/add).
    for ((i = 1; i <= ADD_DEBOUNCE; i++)); do
        sleep 1
        if ! external_present; then
            log "Flap: add cancelled, monitor gone after ${i}s"
            return 0
        fi
    done

    case "$STATE" in
        dormant)
            # Monitor was held through idle - no windows were moved, nothing to restore
            STATE="present"
            log "Monitor returned while dormant - no dance needed"
            update_waybar
            ;;
        absent)
            # Real removal happened earlier, restore the saved layout
            STATE="present"
            log "Monitor added: $1 - restoring workspace layout"
            sync_to_current_workspace
            if [[ -s /tmp/hypr-external-layout.json ]]; then
                ~/.local/bin/hypr-restore-layout
                log "Layout restored"
            fi
            update_waybar
            ;;
        present)
            log "Monitor re-added while already present (ignored)"
            ;;
    esac
}

probe_connector() {
    if ! external_present && connector_connected; then
        log "Probe: connector connected but monitor missing - forcing re-enumeration"
        hyprctl output create "$EXTERNAL_MONITOR" >>"$LOG_FILE" 2>&1
    fi
}

handle() {
    case $1 in
        monitorremoved*) handle_removed "${1#monitorremoved>>}" ;;
        monitoradded*)   handle_added "${1#monitoradded>>}" ;;
    esac
}

# Clear old log on start
echo "=== hypr-event-listener started $(date) ===" > "$LOG_FILE"
log "Listening for monitor events..."

# Multiplex the Hyprland socket and a periodic probe ticker on one FIFO
rm -f "$FIFO"
mkfifo "$FIFO" || { log "FATAL: cannot create fifo $FIFO"; exit 1; }

socat -U - UNIX-CONNECT:"$SOCKET" > "$FIFO" 2>/dev/null &
SOCK_PID=$!

(
    while true; do
        sleep "$PROBE_INTERVAL"
        echo "__PROBE__" > "$FIFO"
    done
) &
PROBE_PID=$!

trap 'kill $SOCK_PID $PROBE_PID 2>/dev/null; rm -f "$FIFO"' EXIT

sleep 0.5
if ! kill -0 "$SOCK_PID" 2>/dev/null; then
    log "FATAL: cannot connect to Hyprland socket $SOCKET"
    exit 1
fi

exec 3< "$FIFO"
while read -r line <&3; do
    [[ -n "$line" ]] || continue
    if [[ "$line" == "__PROBE__" ]]; then
        probe_connector
    else
        handle "$line"
    fi
done
