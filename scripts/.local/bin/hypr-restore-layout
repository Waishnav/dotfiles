#!/bin/bash
# Restore surviving windows to their original external workspaces.
# A Hyprland address plus PID identifies the same live client across workspace
# moves. Class/title are diagnostic only: guessing by them can move an unrelated
# browser window after a title change.

set -o pipefail

LAYOUT_FILE="${HYPR_EXTERNAL_LAYOUT_FILE:-/tmp/hypr-external-layout.json}"

if [[ ! -f "$LAYOUT_FILE" ]]; then
    echo "No saved layout found at $LAYOUT_FILE"
    exit 0
fi

if ! saved_count=$(jq -e 'if type == "array" then length else error("not an array") end' "$LAYOUT_FILE"); then
    echo "Saved layout is invalid: $LAYOUT_FILE" >&2
    exit 1
fi
if [[ "$saved_count" -eq 0 ]]; then
    echo "Saved layout is empty, nothing to restore"
    exit 0
fi

if ! clients=$(hyprctl clients -j 2>/dev/null) ||
    ! jq -e 'type == "array"' <<< "$clients" >/dev/null 2>&1; then
    echo "Unable to read clients while restoring the external layout" >&2
    exit 1
fi

restored=0
skipped=0
failed=0

# Iterate over each saved window entry
while read -r entry; do
    saved_class=$(echo "$entry" | jq -r '.class')
    saved_title=$(echo "$entry" | jq -r '.title')
    saved_address=$(echo "$entry" | jq -r '.address // empty')
    saved_pid=$(echo "$entry" | jq -r '.pid // empty')
    saved_ws=$(echo "$entry" | jq -r '.workspace')
    saved_floating=$(echo "$entry" | jq -r '.floating')
    saved_x=$(echo "$entry" | jq -r '.x')
    saved_y=$(echo "$entry" | jq -r '.y')
    saved_w=$(echo "$entry" | jq -r '.w')
    saved_h=$(echo "$entry" | jq -r '.h')

    # Legacy snapshots intentionally do not fall back to class/title matching.
    # Skipping is safer than moving a different window that happens to share an
    # application class.
    if [[ -z "$saved_address" || -z "$saved_pid" ]]; then
        echo "  Skipped legacy entry without exact identity: $saved_class ($saved_title)"
        skipped=$((skipped + 1))
        continue
    fi

    match_addr=$(jq -r \
        --arg address "$saved_address" \
        --argjson pid "$saved_pid" \
        '[.[] | select(.address == $address and .pid == $pid)] | .[0].address // empty' \
        <<< "$clients")

    if [[ -z "$match_addr" || "$match_addr" == "null" ]]; then
        echo "  Skipped closed window: $saved_class ($saved_title)"
        skipped=$((skipped + 1))
        continue
    fi

    current_ws=$(jq -r --arg address "$match_addr" \
        '.[] | select(.address == $address) | .workspace.id' <<< "$clients")

    # Move window back to original external workspace
    if [[ "$current_ws" != "$saved_ws" ]] &&
        ! hyprctl dispatch movetoworkspacesilent "$saved_ws,address:$match_addr"; then
        echo "  Failed to move: $saved_class -> WS $saved_ws" >&2
        failed=$((failed + 1))
        continue
    fi

    # Restore floating state and geometry if it was floating
    if [[ "$saved_floating" == "true" ]]; then
        # Ensure it's floating
        is_floating=$(jq -r --arg addr "$match_addr" \
            '.[] | select(.address == $addr) | .floating' <<< "$clients")
        if [[ "$is_floating" != "true" ]]; then
            hyprctl dispatch togglefloating "address:$match_addr" || failed=$((failed + 1))
        fi
        hyprctl dispatch resizewindowpixel "exact $saved_w $saved_h,address:$match_addr" || failed=$((failed + 1))
        hyprctl dispatch movewindowpixel "exact $saved_x $saved_y,address:$match_addr" || failed=$((failed + 1))
    fi

    echo "  Restored: $saved_class -> WS $saved_ws"
    restored=$((restored + 1))
done < <(jq -c '.[]' "$LAYOUT_FILE")

echo "Restored $restored / $saved_count window(s)"
echo "Skipped $skipped window(s); failed $failed operation(s)"
((failed == 0))
