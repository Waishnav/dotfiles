#!/bin/bash
# Restore windows to their original external workspaces from saved layout
# Matches windows by class+title, moves them back, and restores floating geometry

LAYOUT_FILE="/tmp/hypr-external-layout.json"

if [[ ! -f "$LAYOUT_FILE" ]]; then
    echo "No saved layout found at $LAYOUT_FILE"
    exit 0
fi

saved_count=$(jq 'length' "$LAYOUT_FILE")
if [[ "$saved_count" -eq 0 ]]; then
    echo "Saved layout is empty, nothing to restore"
    exit 0
fi

restored=0

# Iterate over each saved window entry
jq -c '.[]' "$LAYOUT_FILE" | while read -r entry; do
    saved_class=$(echo "$entry" | jq -r '.class')
    saved_title=$(echo "$entry" | jq -r '.title')
    saved_ws=$(echo "$entry" | jq -r '.workspace')
    saved_floating=$(echo "$entry" | jq -r '.floating')
    saved_x=$(echo "$entry" | jq -r '.x')
    saved_y=$(echo "$entry" | jq -r '.y')
    saved_w=$(echo "$entry" | jq -r '.w')
    saved_h=$(echo "$entry" | jq -r '.h')

    # The window was on external WS 11-18, and got migrated to laptop WS 1-8
    laptop_ws=$((saved_ws - 10))

    # Find the matching window currently on the laptop workspace
    # Match by class first, then narrow by title if multiple matches
    match_addr=$(hyprctl clients -j | jq -r \
        --arg cls "$saved_class" \
        --arg ttl "$saved_title" \
        --argjson ws "$laptop_ws" \
        '[.[] | select(.workspace.id == $ws and .class == $cls)] |
         if length == 1 then .[0].address
         else ([.[] | select(.workspace.id == $ws and .class == $cls and .title == $ttl)] | .[0].address // empty)
         end')

    if [[ -z "$match_addr" || "$match_addr" == "null" ]]; then
        # Fallback: search across all laptop workspaces by class+title
        match_addr=$(hyprctl clients -j | jq -r \
            --arg cls "$saved_class" \
            --arg ttl "$saved_title" \
            '[.[] | select(.workspace.id >= 1 and .workspace.id <= 8 and .class == $cls and .title == $ttl)] | .[0].address // empty')
    fi

    if [[ -z "$match_addr" || "$match_addr" == "null" ]]; then
        echo "  No match for: $saved_class ($saved_title) - skipping"
        continue
    fi

    # Move window back to original external workspace
    hyprctl dispatch movetoworkspacesilent "$saved_ws,address:$match_addr"

    # Restore floating state and geometry if it was floating
    if [[ "$saved_floating" == "true" ]]; then
        # Ensure it's floating
        is_floating=$(hyprctl clients -j | jq -r --arg addr "$match_addr" '.[] | select(.address == $addr) | .floating')
        if [[ "$is_floating" != "true" ]]; then
            hyprctl dispatch togglefloating "address:$match_addr"
        fi
        hyprctl dispatch resizewindowpixel "exact $saved_w $saved_h,address:$match_addr"
        hyprctl dispatch movewindowpixel "exact $saved_x $saved_y,address:$match_addr"
    fi

    echo "  Restored: $saved_class -> WS $saved_ws"
    restored=$((restored + 1))
done

echo "Restored $restored / $saved_count window(s)"
