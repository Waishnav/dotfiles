#!/usr/bin/env bash
set -euo pipefail

status_icon_dir="${HOME}/.local/share/outloud/icons/scalable/status"
waveform_icon_dir="${HOME}/.config/waybar/outloud-icons"
cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/outloud/waybar-icons"
theme_file="${HOME}/.config/omarchy/current/theme/waybar.css"

foreground=$(awk '
  $1 == "@define-color" && $2 == "foreground" {
    gsub(/;/, "", $3)
    print $3
    exit
  }
' "$theme_file" 2>/dev/null || true)
foreground=${foreground:-#dcd7ba}

if state=$(timeout 0.15s "${HOME}/.local/bin/outloud" status 2>/dev/null); then
  case "$state" in
    idle)
      source_icon="${waveform_icon_dir}/outloud-wave-idle.svg"
      cache_key="outloud-wave-idle-fixed"
      recolor=false
      tooltip="Outloud — ready"
      ;;
    recording)
      frame=$(( ($(date +%s%N) / 200000000) % 6 ))
      source_icon="${waveform_icon_dir}/outloud-wave-recording-${frame}.svg"
      cache_key="outloud-wave-recording-${frame}-fixed"
      recolor=false
      tooltip="Outloud — recording"
      ;;
    processing)
      frame=$(( ($(date +%s%N) / 200000000) % 4 ))
      source_icon="${status_icon_dir}/outloud-processing-${frame}-symbolic.svg"
      cache_key="outloud-processing-${frame}-symbolic-${foreground#\#}"
      recolor=true
      tooltip="Outloud — transcribing"
      ;;
    error)
      source_icon="${status_icon_dir}/outloud-error-symbolic.svg"
      cache_key="outloud-error-symbolic-${foreground#\#}"
      recolor=true
      tooltip="Outloud — error"
      ;;
    *)
      source_icon="${status_icon_dir}/outloud-error-symbolic.svg"
      cache_key="outloud-error-symbolic-${foreground#\#}"
      recolor=true
      tooltip="Outloud — unknown state"
      ;;
  esac
else
  source_icon="${status_icon_dir}/outloud-error-symbolic.svg"
  cache_key="outloud-error-symbolic-${foreground#\#}"
  recolor=true
  tooltip="Outloud — service unavailable"
fi

cached_icon="${cache_dir}/${cache_key}.png"

# Waybar's image module cannot decode SVGs on this setup, so keep a
# raster cache for the small pinned status icon.
if [[ ! -f "$cached_icon" || "$source_icon" -nt "$cached_icon" ]]; then
  mkdir -p "$cache_dir"
  temporary_icon="${cached_icon}.$$"
  trap 'rm -f "$temporary_icon"' EXIT
  if [[ "$recolor" == true ]]; then
    sed "s/currentColor/${foreground}/g" "$source_icon" |
      rsvg-convert --width 72 --height 72 --output "$temporary_icon" -
  else
    rsvg-convert --width 72 --height 72 --output "$temporary_icon" "$source_icon"
  fi
  mv "$temporary_icon" "$cached_icon"
  trap - EXIT
fi

printf '%s\n%s\n' "$cached_icon" "$tooltip"
