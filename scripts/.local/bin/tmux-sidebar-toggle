#!/usr/bin/env bash
# tmux-sidebar-toggle: Launch or focus the tmux sidebar tiled window
#
# First call:  launches alacritty with sidebar-tui class (tiles on current workspace)
# Next calls:  focuses the existing sidebar window
#
# Old overlay functions (show/hide/slide) kept below for reference.

CLASS="sidebar-tui"

get_sidebar_addr() {
    hyprctl clients -j 2>/dev/null | jq -r ".[] | select(.class == \"$CLASS\") | .address" | head -1
}

launch_sidebar() {
    alacritty --class "$CLASS" -e /home/waishnav/.local/bin/tmux-sidebar &
    disown $!

    local addr=""
    local tries=0
    while [[ -z "$addr" && $tries -lt 40 ]]; do
        sleep 0.1
        addr=$(get_sidebar_addr)
        tries=$((tries + 1))
    done
    [[ -z "$addr" ]] && return 1

    # Move sidebar to the left and shrink it
    sleep 0.2
    hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
    hyprctl dispatch swapnext >/dev/null 2>&1
    hyprctl dispatch resizeactive -900 0 >/dev/null 2>&1

    echo "$addr"
}

focus_or_launch() {
    local addr
    addr=$(get_sidebar_addr)

    if [[ -z "$addr" ]]; then
        addr=$(launch_sidebar)
        [[ -z "$addr" ]] && exit 1
    fi

    hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
}

focus_or_launch

