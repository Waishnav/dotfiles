#!/bin/bash
# Save the current window layout on external workspaces (11-16)
# Captures the exact client identity, workspace, and floating geometry.
# Saved to a JSON file so hypr-restore-layout can recover it on reconnect

set -o pipefail

LAYOUT_FILE="${HYPR_EXTERNAL_LAYOUT_FILE:-/tmp/hypr-external-layout.json}"
EXTERNAL_WS_MIN=11
EXTERNAL_WS_MAX=16

# Build the snapshot in memory so a failed query cannot overwrite a valid file.
if ! layout=$(hyprctl clients -j 2>/dev/null | jq -c \
  "[.[] | select(.workspace.id >= $EXTERNAL_WS_MIN and .workspace.id <= $EXTERNAL_WS_MAX) | {
    address: .address,
    pid: .pid,
    class: .class,
    title: .title,
    workspace: .workspace.id,
    floating: .floating,
    x: .at[0],
    y: .at[1],
    w: .size[0],
    h: .size[1]
  }]"); then
    echo "Unable to read the external window layout" >&2
    exit 1
fi

printf '%s\n' "$layout" > "$LAYOUT_FILE"
count=$(jq 'length' <<< "$layout")
echo "Saved $count window(s) to $LAYOUT_FILE"
