#!/bin/bash
# Dynamically update waybar config based on connected monitors
# jsonc-safe: strips full-line // comments before processing with jq.
# Only reloads waybar when the workspace set actually changes.

CONFIG_FILE="$HOME/.config/waybar/config.jsonc"
EXTERNAL_MONITOR="HDMI-A-1"

# Check if external monitor is connected
has_external=$(hyprctl monitors -j | jq -r --arg m "$EXTERNAL_MONITOR" '.[] | select(.name == $m) | .name' | head -1)

if [[ -n "$has_external" ]]; then
    # Dual monitor mode: laptop WS 1-6, external WS 11-16
    new_workspaces='{"eDP-1": [1,2,3,4,5,6], "HDMI-A-1": [11,12,13,14,15,16]}'
else
    # Laptop only mode: show only WS 1-6
    new_workspaces='{"eDP-1": [1,2,3,4,5,6]}'
fi

strip_comments() {
    sed -E '/^[[:space:]]*\/\//d' "$CONFIG_FILE"
}

# Only touch waybar when the workspace set actually changes
current=$(strip_comments | jq -c '."hyprland/workspaces"."persistent-workspaces"')
target=$(printf '%s' "$new_workspaces" | jq -c .)

if [[ "$current" == "$target" ]]; then
    exit 0
fi

# Update the config file using jq
tmp_file=$(mktemp)
strip_comments | jq --argjson ws "$new_workspaces" \
    '."hyprland/workspaces"."persistent-workspaces" = $ws' \
    > "$tmp_file" && mv "$tmp_file" "$CONFIG_FILE"

# Reload waybar (SIGUSR2 reloads config)
pkill -SIGUSR2 waybar
