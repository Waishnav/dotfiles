#!/bin/bash
# Dynamically update waybar config based on connected monitors

CONFIG_FILE="$HOME/.config/waybar/config.jsonc"
EXTERNAL_MONITOR="HDMI-A-1"

# Check if external monitor is connected
has_external=$(hyprctl monitors -j | jq -r ".[] | select(.name == \"$EXTERNAL_MONITOR\") | .name")

if [[ -n "$has_external" ]]; then
    # Dual monitor mode: show laptop WS 1-8, external WS 11-18
    new_workspaces='{"eDP-1": [1,2,3,4,5,6,7,8], "HDMI-A-1": [11,12,13,14,15,16,17,18]}'
else
    # Laptop only mode: show only WS 1-8
    new_workspaces='{"eDP-1": [1,2,3,4,5,6,7,8]}'
fi

# Update the config file using jq
tmp_file=$(mktemp)
jq --argjson ws "$new_workspaces" \
   '."hyprland/workspaces"."persistent-workspaces" = $ws' \
   "$CONFIG_FILE" > "$tmp_file" && mv "$tmp_file" "$CONFIG_FILE"

# Reload waybar (SIGUSR2 reloads config)
pkill -SIGUSR2 waybar
